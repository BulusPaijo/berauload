# Referensi konfigurasi. Jangan pakai ini sebagai kredensial production.
# ./deploy/install.sh akan membuat .env dengan rahasia acak jika belum ada.
APP_PORT=8092
POSTGRES_USER=berauload
POSTGRES_PASSWORD=
POSTGRES_DB=berauload
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
COOKIE_SECURE=false

# Stage 7: one worker enforced until multi-process setup/cache is proven safe
SESSION_HOURS=12
SESSION_MAX_HOURS=24
UVICORN_WORKERS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# ONLY in isolated test compose; never enable for production
BERAULOAD_TEST_INSTANCE=false
